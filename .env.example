# Set these in Netlify: Site configuration → Environment variables.
# Never commit real values. Both features answer "not set up yet" until they are set.

# ── Sample report email (Gmail SMTP) ──────────────────────────────────────────
# The Gmail account the email is sent from, and a Google app password for it
# (Google Account → Security → 2-Step Verification → App passwords).
SMTP_USER=praxis.noreply@gmail.com
SMTP_PASS=
# Optional: who gets a copy of each request, so the team sees the lead.
LEADS_TO=

# ── Chatbot (OpenRouter) ──────────────────────────────────────────────────────
OPENROUTER_API_KEY=
# Optional: any OpenRouter model slug. Default: openrouter/auto.
OPENROUTER_MODEL=

# ── Links ─────────────────────────────────────────────────────────────────────
# Not secret: set in src/site-config.js instead (cal.com booking link).
